# 로컬 개발용 비밀값 — 이 파일을 복사해서 `.dev.vars` 로 저장하고 값을 채우세요.
# `.dev.vars` 는 .gitignore에 들어 있어야 하며, 절대 커밋·공유하지 않습니다.
# 배포용은 파일이 아니라 `npx wrangler secret put <이름>` 으로 넣습니다.
#
# ⚠️ 여기 값을 하나도 안 채워도 오피스는 정상 작동합니다.
#    (연동 항목만 화면에 "미설정"으로 표시됩니다)
#    나중에 진짜 Notion·Discord에 보고서를 보내고 싶을 때만 채우세요.

# ── Notion ─────────────────────────────────────────────
# 1) https://www.notion.so/my-integrations 에서 내부 통합 생성 → Secret 복사 (ntn_ 로 시작)
# 2) 보고서를 받을 Notion 페이지 열기 → 우측 상단 ⋯ → 연결 → 만든 통합 추가
#    (이 2단계를 안 하면 API가 404를 냅니다)
NOTION_TOKEN=
# 보고서를 저장할 데이터베이스 ID (Notion DB 주소의 32자리 문자열)
NOTION_BRIEFING_DB=

# ── Discord ────────────────────────────────────────────
# 보고를 받을 채널 → 채널 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# ── Claude (오늘의 AI 리서치) ────────────────────────────
# 1) https://console.anthropic.com 가입 → 결제수단 등록 → API Keys 메뉴에서 키 발급 (sk-ant- 로 시작)
# 2) 이 키는 사용한 만큼 비용이 청구됩니다 (브리핑 1회 생성에 대략 몇 백 원 수준)
# 채워두면 화면의 "🧠 오늘의 AI 리서치" 버튼이 실제 웹 검색으로 오늘 시황을 찾아 리포트를 씁니다.
ANTHROPIC_API_KEY=

# ── 종목 리포트 (토스증권·DART, 직접 만든 SGS Connector) ──
# AI(Claude)를 쓰지 않는 순수 데이터 조회라 비용이 들지 않습니다.
# TOSS_API_KEY: SGS Connector openapi 스키마의 MyApiKey (X-API-Key 헤더 값)과 동일하게 입력
# TOSS_API_BASE_URL: SGS Connector 서버 주소 (예: https://xxxx.ngrok-free.dev), 끝에 / 는 빼주세요
# ⚠️ ngrok 무료 터널은 컴퓨터를 껐다 켜거나 ngrok을 재시작할 때마다 주소가 바뀝니다.
#    그때마다 여기 TOSS_API_BASE_URL을 새 주소로 바꿔줘야 하고, SGS Connector 서버 자체도 켜져 있어야 합니다.
TOSS_API_KEY=
TOSS_API_BASE_URL=
